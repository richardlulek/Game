{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Property Empire",
  "version": "2.0.0",
  "identifier": "com.propertyempire.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Property Empire",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "Game",
    "shortDescription": "Property tycoon – build an empire block by block.",
    "longDescription": "Property Empire is a property-tycoon game: buy, build, lease and grow across a living 3D city with rivals, an M&A boardroom and a story campaign."
  }
}
